{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camilobuilder.dev/governance/schemas/v1/architecture.schema.json",
  "title": "CamiloBuilder architecture record schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "record_version",
    "architecture_version",
    "constitution_version",
    "status",
    "builders",
    "commands",
    "component_types",
    "templates",
    "contract_ids",
    "capability_ids",
    "dependency_ids"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "record_version": { "$ref": "#/$defs/semver" },
    "architecture_version": { "$ref": "#/$defs/semver" },
    "constitution_version": { "$ref": "#/$defs/semver" },
    "status": { "enum": ["proposed", "approved", "active", "superseded"] },
    "builders": { "$ref": "#/$defs/ids" },
    "commands": { "$ref": "#/$defs/ids" },
    "component_types": { "$ref": "#/$defs/ids" },
    "templates": { "$ref": "#/$defs/ids" },
    "contract_ids": { "$ref": "#/$defs/ids" },
    "capability_ids": { "$ref": "#/$defs/ids" },
    "dependency_ids": { "$ref": "#/$defs/ids" },
    "source_commit": { "$ref": "#/$defs/commit" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
  }
}

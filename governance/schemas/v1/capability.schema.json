{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camilobuilder.dev/governance/schemas/v1/capability.schema.json",
  "title": "CamiloBuilder capability record schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "record_version", "status", "name", "component_type_ids", "provider_ids", "contract_ids", "dependency_ids", "work_order_id"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "record_version": { "$ref": "#/$defs/semver" },
    "status": { "enum": ["proposed", "active", "deprecated", "removed"] },
    "name": { "type": "string", "minLength": 1 },
    "component_type_ids": { "$ref": "#/$defs/ids" },
    "provider_ids": { "$ref": "#/$defs/ids" },
    "contract_ids": { "$ref": "#/$defs/ids" },
    "dependency_ids": { "$ref": "#/$defs/ids" },
    "work_order_id": { "$ref": "#/$defs/id" },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camilobuilder.dev/governance/schemas/v1/contract.schema.json",
  "title": "CamiloBuilder contract record schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "record_version", "status", "scope", "stability", "owner", "work_order_id", "change_type", "consumer_ids", "guarantees", "compatible_changes", "incompatible_changes"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "record_version": { "$ref": "#/$defs/semver" },
    "status": { "enum": ["proposed", "active", "deprecated", "removed"] },
    "scope": { "enum": ["public", "internal"] },
    "stability": { "enum": ["experimental", "stable", "deprecated"] },
    "owner": { "type": "string", "minLength": 1 },
    "work_order_id": { "$ref": "#/$defs/id" },
    "change_type": { "enum": ["creates", "modifies", "deprecates", "removes", "none"] },
    "consumer_ids": { "$ref": "#/$defs/ids" },
    "guarantees": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "compatible_changes": { "$ref": "#/$defs/nonEmptyStrings" },
    "incompatible_changes": { "$ref": "#/$defs/nonEmptyStrings" },
    "capability_ids": { "$ref": "#/$defs/ids" },
    "dependency_ids": { "$ref": "#/$defs/ids" },
    "supersedes_id": { "$ref": "#/$defs/id" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camilobuilder.dev/governance/schemas/v1/exception.schema.json",
  "title": "CamiloBuilder temporary exception record schema v1",
  "description": "Chronological comparison of starts_at and expires_at is reserved for later semantic auditing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "record_version", "status", "constitutional_rule", "justification", "scope", "affected_component_ids", "affected_contract_ids", "risks", "compensating_controls", "owner", "approval_ids", "starts_at", "expires_at", "remediation_work_order_id", "closure_criteria", "reversal"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "record_version": { "$ref": "#/$defs/semver" },
    "status": { "enum": ["proposed", "active", "expired", "closed", "revoked"] },
    "constitutional_rule": { "type": "string", "minLength": 1 },
    "justification": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "affected_component_ids": { "$ref": "#/$defs/ids" },
    "affected_contract_ids": { "$ref": "#/$defs/ids" },
    "risks": { "$ref": "#/$defs/nonEmptyStrings" },
    "compensating_controls": { "$ref": "#/$defs/nonEmptyStrings" },
    "owner": { "type": "string", "minLength": 1 },
    "approval_ids": { "$ref": "#/$defs/nonEmptyIds" },
    "starts_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "remediation_work_order_id": { "$ref": "#/$defs/id" },
    "closure_criteria": { "type": "string", "minLength": 1 },
    "reversal": { "type": "string", "minLength": 1 },
    "affected_capability_ids": { "$ref": "#/$defs/ids" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "nonEmptyIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}

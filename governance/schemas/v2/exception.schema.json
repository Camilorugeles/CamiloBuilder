{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camilobuilder.dev/governance/schemas/v2/exception.schema.json",
  "title": "CamiloBuilder constitutional exception schema v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "record_version",
    "status",
    "conformance_status",
    "constitution_version",
    "constitutional_provision",
    "justification",
    "scope",
    "creates_precedent",
    "approval_policy",
    "owner_id",
    "approval_ids",
    "starts_at",
    "expires_at",
    "remediation_work_order_id",
    "affected_component_ids",
    "affected_contract_ids",
    "affected_capability_ids",
    "risks",
    "compensating_controls",
    "closure_criteria",
    "reversal",
    "status_history"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "$ref": "#/$defs/exceptionId" },
    "record_version": { "$ref": "#/$defs/semver" },
    "status": { "$ref": "#/$defs/status" },
    "conformance_status": {
      "enum": ["pending", "temporarily_authorized", "nonconforming", "resolved"]
    },
    "constitution_version": { "const": "1.0.0" },
    "constitutional_provision": { "$ref": "#/$defs/id" },
    "justification": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "creates_precedent": { "const": false },
    "approval_policy": { "enum": ["ordinary", "critical"] },
    "owner_id": { "$ref": "#/$defs/id" },
    "approval_ids": { "$ref": "#/$defs/ids" },
    "starts_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "remediation_work_order_id": { "$ref": "#/$defs/workOrderId" },
    "affected_component_ids": { "$ref": "#/$defs/ids" },
    "affected_contract_ids": { "$ref": "#/$defs/ids" },
    "affected_capability_ids": { "type": "array", "maxItems": 0 },
    "risks": { "$ref": "#/$defs/strings" },
    "compensating_controls": { "$ref": "#/$defs/strings" },
    "closure_criteria": { "type": "string" },
    "reversal": { "type": "string" },
    "status_history": {
      "type": "array",
      "items": { "$ref": "#/$defs/transition" }
    },
    "closure": { "$ref": "#/$defs/closure" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "proposed" } }, "required": ["status"] },
      "then": { "properties": { "conformance_status": { "const": "pending" } } }
    },
    {
      "if": { "properties": { "status": { "const": "active" } }, "required": ["status"] },
      "then": {
        "properties": {
          "conformance_status": { "const": "temporarily_authorized" },
          "approval_ids": { "minItems": 1 },
          "risks": { "minItems": 1 },
          "compensating_controls": { "minItems": 1 },
          "closure_criteria": { "minLength": 1 },
          "reversal": { "minLength": 1 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["expired", "revoked"] } }, "required": ["status"] },
      "then": { "properties": { "conformance_status": { "const": "nonconforming" } } }
    },
    {
      "if": { "properties": { "status": { "const": "closed" } }, "required": ["status"] },
      "then": {
        "required": ["closure"],
        "properties": { "conformance_status": { "const": "resolved" } }
      }
    },
    {
      "if": { "properties": { "status": { "const": "revoked" } }, "required": ["status"] },
      "then": { "required": ["closure"] }
    },
    {
      "if": {
        "properties": {
          "constitutional_provision": {
            "enum": ["principle.failure-safe", "principle.least-privilege", "principle.non-destruction"]
          }
        },
        "required": ["constitutional_provision"]
      },
      "then": { "properties": { "approval_policy": { "const": "critical" } } }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "active" },
          "approval_policy": { "const": "critical" }
        },
        "required": ["status", "approval_policy"]
      },
      "then": { "properties": { "approval_ids": { "minItems": 2 } } }
    }
  ],
  "$defs": {
    "exceptionId": { "type": "string", "pattern": "^EXCEPTION-[0-9]{3,}$" },
    "workOrderId": { "type": "string", "pattern": "^WORK-[0-9]{3,}$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "status": { "enum": ["proposed", "active", "expired", "closed", "revoked"] },
    "ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "strings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "at"],
      "properties": {
        "from": { "$ref": "#/$defs/status" },
        "to": { "$ref": "#/$defs/status" },
        "at": { "type": "string", "format": "date-time" }
      },
      "oneOf": [
        { "properties": { "from": { "const": "proposed" }, "to": { "enum": ["active", "expired", "revoked"] } } },
        { "properties": { "from": { "const": "active" }, "to": { "enum": ["expired", "closed", "revoked"] } } },
        { "properties": { "from": { "const": "expired" }, "to": { "const": "closed" } } }
      ]
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "reason", "approval_ids"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1 },
        "approval_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    }
  }
}

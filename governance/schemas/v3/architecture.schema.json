{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camilobuilder.dev/governance/schemas/v3/architecture.schema.json",
  "title": "CamiloBuilder governed architecture registry schema v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "record_version",
    "architecture_version",
    "status",
    "contract_ids",
    "modules"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "id": { "$ref": "#/$defs/id" },
    "record_version": { "$ref": "#/$defs/semver" },
    "architecture_version": { "$ref": "#/$defs/semver" },
    "status": { "enum": ["proposed", "approved", "active", "superseded"] },
    "contract_ids": { "$ref": "#/$defs/nonEmptyIds" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_][A-Za-z0-9._-]*(?:/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"
    },
    "ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "nonEmptyIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "paths",
        "stability",
        "responsibilities",
        "provides_contract_ids",
        "consumes_contract_ids",
        "allowed_dependency_ids",
        "prohibited_dependency_ids"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/path" },
          "uniqueItems": true
        },
        "stability": { "enum": ["experimental", "stable", "deprecated"] },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "provides_contract_ids": { "$ref": "#/$defs/ids" },
        "consumes_contract_ids": { "$ref": "#/$defs/ids" },
        "allowed_dependency_ids": { "$ref": "#/$defs/ids" },
        "prohibited_dependency_ids": { "$ref": "#/$defs/ids" }
      }
    }
  }
}

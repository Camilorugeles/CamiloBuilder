{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camilobuilder.local/schemas/execution-record-v1.json",
  "title": "Camilo OS Execution Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_version", "revision", "run_id", "agent_id", "agent_version", "status", "input_refs", "results", "proposed_actions", "human_decision", "executed_actions", "errors", "escalation", "evidence_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "record_version": {"const": "1.0.0"},
    "revision": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "pattern": "^run:sha256:[0-9a-f]{64}$"},
    "agent_id": {"type": "string", "pattern": "^agent\\.[a-z0-9][a-z0-9._-]*$"},
    "agent_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "status": {"enum": ["completed", "pending_approval", "needs_review", "failed"]},
    "input_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/inputReference"}},
    "results": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/result"}},
    "proposed_actions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/proposal"}},
    "human_decision": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/decision"}]},
    "executed_actions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/execution"}},
    "errors": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/error"}},
    "escalation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/escalation"}]},
    "evidence_refs": {"$ref": "#/$defs/stringSet"}
  },
  "$defs": {
    "jsonValue": {"type": ["array", "boolean", "null", "number", "object", "string"]},
    "stringSet": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "inputReference": {"type": "object", "additionalProperties": false, "required": ["source_id", "reference"], "properties": {"source_id": {"type": "string", "minLength": 1}, "reference": {"type": "string", "minLength": 1}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["result_id", "kind", "value"], "properties": {"result_id": {"type": "string", "pattern": "^result\\.[a-z0-9][a-z0-9._-]*$"}, "kind": {"type": "string", "minLength": 1}, "value": {"$ref": "#/$defs/jsonValue"}, "confidence": {"enum": ["low", "medium", "high"]}}},
    "proposal": {"type": "object", "additionalProperties": false, "required": ["proposal_id", "action_id", "parameters", "approval", "status"], "properties": {"proposal_id": {"type": "string", "pattern": "^proposal:sha256:[0-9a-f]{64}$"}, "action_id": {"type": "string", "pattern": "^action\\.[a-z0-9][a-z0-9._-]*$"}, "parameters": {"type": "object"}, "approval": {"enum": ["none", "required"]}, "status": {"enum": ["pending", "approved", "rejected"]}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["decision", "decided_by", "decision_ref", "notes"], "properties": {"decision": {"enum": ["approved", "rejected"]}, "decided_by": {"type": "string", "minLength": 1}, "decision_ref": {"type": "string", "minLength": 1}, "notes": {"type": "string"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["execution_id", "proposal_id", "action_id", "outcome", "result_ref"], "properties": {"execution_id": {"type": "string", "pattern": "^execution:sha256:[0-9a-f]{64}$"}, "proposal_id": {"type": "string", "pattern": "^proposal:sha256:[0-9a-f]{64}$"}, "action_id": {"type": "string", "minLength": 1}, "outcome": {"enum": ["completed", "failed"]}, "result_ref": {"type": "string", "minLength": 1}}},
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "message": {"type": "string", "minLength": 1}}},
    "escalation": {"type": "object", "additionalProperties": false, "required": ["code", "reason"], "properties": {"code": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}}
  }
}

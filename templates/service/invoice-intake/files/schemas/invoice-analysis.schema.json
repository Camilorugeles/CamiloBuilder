{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://camilobuilder.local/schemas/invoice-analysis-v1.json", "title": "Camilo OS Invoice Analysis v1",
  "type": "object", "additionalProperties": false,
  "required": ["format", "format_version", "gmail_message_ref", "attachment_refs", "attachments", "content_fingerprints", "fields", "arithmetic_consistency", "legal_entity", "activity", "document_status", "destination_status", "proposed_destination_ref", "global_confidence", "unknown_fields", "warnings", "review_required", "review_reasons", "duplicate_refs"],
  "properties": {
    "format": {"const": "camilo-os.invoice-analysis"}, "format_version": {"const": 1}, "gmail_message_ref": {"type": "string", "minLength": 1}, "attachment_refs": {"$ref": "#/$defs/strings"}, "attachments": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["reference", "filename", "media_type", "fingerprint"], "properties": {"reference": {"type": "string", "minLength": 1}, "filename": {"type": "string", "minLength": 1}, "media_type": {"type": "string", "minLength": 1}, "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}}, "content_fingerprints": {"$ref": "#/$defs/strings"},
    "fields": {"type": "object", "additionalProperties": false, "required": ["document_type", "supplier", "supplier_tax_id", "invoice_number", "issue_date", "recipient", "recipient_tax_id", "taxable_base", "vat", "other_taxes", "withholdings", "total", "currency", "concept"], "properties": {"document_type": {"$ref": "#/$defs/field"}, "supplier": {"$ref": "#/$defs/field"}, "supplier_tax_id": {"$ref": "#/$defs/field"}, "invoice_number": {"$ref": "#/$defs/field"}, "issue_date": {"$ref": "#/$defs/field"}, "recipient": {"$ref": "#/$defs/field"}, "recipient_tax_id": {"$ref": "#/$defs/field"}, "taxable_base": {"$ref": "#/$defs/field"}, "vat": {"$ref": "#/$defs/field"}, "other_taxes": {"$ref": "#/$defs/field"}, "withholdings": {"$ref": "#/$defs/field"}, "total": {"$ref": "#/$defs/field"}, "currency": {"$ref": "#/$defs/field"}, "concept": {"$ref": "#/$defs/field"}}},
    "arithmetic_consistency": {"enum": ["consistent", "inconsistent", "unknown"]}, "legal_entity": {"type": "string", "minLength": 1}, "activity": {"type": "string", "minLength": 1},
    "document_status": {"enum": ["candidate", "not_an_invoice", "invoice_complete", "invoice_incomplete", "credit_note", "receipt_or_ticket", "duplicate_suspected", "personal_suspected", "internal_transfer", "needs_review"]},
    "destination_status": {"enum": ["resolved", "unresolved"]}, "proposed_destination_ref": {"type": ["null", "string"]}, "global_confidence": {"enum": ["high", "medium", "low"]}, "unknown_fields": {"$ref": "#/$defs/strings"}, "warnings": {"$ref": "#/$defs/strings"}, "review_required": {"type": "boolean"}, "review_reasons": {"$ref": "#/$defs/strings"}, "duplicate_refs": {"$ref": "#/$defs/strings"}
  },
  "$defs": {"strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "field": {"type": "object", "additionalProperties": false, "required": ["value", "status", "source_ref", "confidence"], "properties": {"value": {"type": ["null", "string"]}, "status": {"enum": ["extracted", "derived", "unknown", "conflict"]}, "source_ref": {"type": "string", "minLength": 1}, "confidence": {"enum": ["high", "medium", "low"]}}}}
}

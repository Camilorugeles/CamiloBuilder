{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camilobuilder.local/schemas/invoice-pilot-config-v1.json",
  "title": "Camilo OS Invoice Intake Pilot Configuration v1",
  "type": "object", "additionalProperties": false,
  "required": ["format", "format_version", "mode", "gmail_connector_alias", "drive_connector_alias", "selection", "destinations", "legal_entities", "activities", "document_types", "knowledge_refs", "reviewer_refs", "execution_store_path", "duplicate_store_path", "classification_rules"],
  "properties": {
    "format": {"const": "camilo-os.invoice-intake-pilot"}, "format_version": {"const": 1}, "mode": {"const": "shadow"},
    "gmail_connector_alias": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"}, "drive_connector_alias": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
    "selection": {"type": "object", "additionalProperties": false, "required": ["query", "pilot_message_refs", "max_messages", "max_per_supplier"], "properties": {"query": {"type": "string", "minLength": 1}, "pilot_message_refs": {"type": "array", "minItems": 1, "maxItems": 15, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[^\\s]+$"}}, "max_messages": {"type": "integer", "minimum": 1, "maximum": 15}, "max_per_supplier": {"const": 2}}},
    "destinations": {"type": "object", "additionalProperties": false, "required": ["classify", "missing_data", "pending_accounting", "pending_reconciliation", "activity_destinations"], "properties": {"classify": {"type": "string", "minLength": 1}, "missing_data": {"type": "string", "minLength": 1}, "pending_accounting": {"type": "string", "minLength": 1}, "pending_reconciliation": {"type": "string", "minLength": 1}, "activity_destinations": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"}, "additionalProperties": {"type": "string", "minLength": 1}}}},
    "legal_entities": {"$ref": "#/$defs/identifiers"}, "activities": {"$ref": "#/$defs/identifiers"}, "document_types": {"$ref": "#/$defs/identifiers"}, "knowledge_refs": {"$ref": "#/$defs/strings"}, "reviewer_refs": {"$ref": "#/$defs/strings"},
    "execution_store_path": {"type": "string", "minLength": 1}, "duplicate_store_path": {"type": "string", "minLength": 1},
    "classification_rules": {"type": "object", "additionalProperties": false, "required": ["recipient_rules", "activity_rules", "personal_terms", "internal_transfer_terms", "shared_terms", "arras_terms", "sensitive_terms"], "properties": {"recipient_rules": {"$ref": "#/$defs/rules"}, "activity_rules": {"$ref": "#/$defs/rules"}, "personal_terms": {"$ref": "#/$defs/strings"}, "internal_transfer_terms": {"$ref": "#/$defs/strings"}, "shared_terms": {"$ref": "#/$defs/strings"}, "arras_terms": {"$ref": "#/$defs/strings"}, "sensitive_terms": {"$ref": "#/$defs/strings"}}}
  },
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "identifiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
    "rules": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["evidence", "value"], "properties": {"evidence": {"type": "string", "minLength": 1}, "value": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}}}
  }
}
